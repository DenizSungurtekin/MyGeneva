# Copy to backend/.env for local dev, or set the same keys in Railway's UI
# for production. .env is gitignored — never commit real secrets.

# Postgres connection string. Local dev via docker-compose:
#   postgresql+psycopg://mygeneva:mygeneva@localhost:5432/mygeneva
# Leave empty to fall back to SQLite at backend/mygeneva.db (only for tests
# or a quick local run without Docker).
# Railway: automatically injected as $DATABASE_URL when you attach the
# Postgres plugin — DO NOT set it manually in Railway.
DATABASE_URL=

# Google Maps Platform key — used by the enricher and by /places/{id}/refresh.
# Restricted server-side to Places API + Maps Static in the GCP console.
MYGENEVA_GOOGLE_MAPS_KEY=

# Single POC user id under which favorites are stored today. Will be replaced
# by real auth in a later phase.
POC_USER_ID=poc-user

# Comma-separated list of allowed CORS origins. Empty (or unset) → wildcard,
# which is what we want for a deployed backend serving native mobile apps
# (native apps don't send an Origin, and wildcard doesn't hurt because we
# don't use cookie auth).
# For Expo web dev locally, add: http://localhost:19006
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000,exp://localhost:19000
