# Database — laisser vide pour SQLite local (backend/mygeneva.db), sinon URL Postgres
# Exemple Postgres via docker-compose : postgresql+psycopg://mygeneva:mygeneva@localhost:5432/mygeneva
DATABASE_URL=

# Identifiant POC pour les favoris (pas d'auth au MVP)
POC_USER_ID=poc-user

# CORS (origines autorisées, séparées par une virgule)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000,exp://localhost:19000
